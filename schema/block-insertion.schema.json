{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas/block-insertion.schema.json",
  "title": "BlockInsertion",
  "description": "Schema for Block Insertion Theorem fixtures and test vectors.",
  "type": "object",
  "required": [
    "metadata",
    "blocks",
    "operations",
    "indicesConvention"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["schemaVersion", "generator", "created"],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+$"
        },
        "generator": {
          "type": "object",
          "required": ["name", "version", "commit"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "commit": { "type": "string" }
          },
          "additionalProperties": false
        },
        "created": { "type": "string", "format": "date-time" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "indicesConvention": {
      "type": "object",
      "required": ["base"],
      "properties": {
        "base": { "type": "integer", "enum": [0, 1] },
        "inclusiveUpper": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "length", "content"],
        "properties": {
          "id": { "type": "string" },
          "length": { "type": "integer", "minimum": 0 },
          "content": { "type": "string" },
          "annotations": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
          }
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["opId", "type", "sourceBlock", "targetIndex"],
        "properties": {
          "opId": { "type": "string" },
          "type": { "type": "string", "enum": ["insert", "replace", "delete"] },
          "sourceBlock": { "type": "string" },
          "targetIndex": { "type": "integer", "minimum": 0 },
          "length": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "examples": []
}